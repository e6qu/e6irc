[Unit]
Description=e6irc server, web application, and bouncer
Documentation=https://github.com/e6qu/e6irc/tree/main/deploy
Wants=network-online.target
After=network-online.target
# A refused database connection fails the daemon in milliseconds; five of
# those inside systemd's default ten-second window would leave the unit
# permanently failed (start-limit-hit) after a reboot where PostgreSQL comes up
# later than e6ircd. Restarts stay bounded by RestartSec, and each attempt is a
# journal line, so the failure is loud rather than final.
StartLimitIntervalSec=0

[Service]
Type=simple
User=e6irc
Group=e6irc
ExecStart=/usr/local/bin/e6ircd --config /etc/e6irc/e6ircd.toml
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=55s
LimitNOFILE=262144
UMask=0077

# The daemon persists through PostgreSQL and needs no writable host filesystem.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# It binds sockets, reads its configuration, and connects out. It opens no
# device (randomness comes from the pseudo-devices PrivateDevices keeps), starts
# no process, creates no namespace, uses no System V IPC, and reads nothing
# under /proc but its own entries.
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RemoveIPC=true
SystemCallArchitectures=native
# A call outside the set fails with EPERM instead of killing the daemon, so a
# C library newer than this systemd's idea of @system-service degrades to its
# fallback path rather than to a crash loop.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
